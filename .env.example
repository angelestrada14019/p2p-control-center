# Copia este archivo a `.env` y ajusta los valores. `.env` NO se versiona.
# Ver .claude/docs/09-infraestructura.md
#
# IMPORTANTE: Vite inyecta toda variable VITE_ en el bundle del cliente.
# NUNCA pongas un secreto aquí. La anon key de Supabase es pública por diseño;
# una credencial de Snowflake o una service_role key JAMÁS.

# Selector de adaptador de datos: mock | real
# Ver .claude/docs/04-datos.md §5
VITE_DATA_SOURCE=mock

# Etiqueta de entorno mostrada en la interfaz: local | preview | staging | prod
VITE_APP_ENV=local

# Destino del Módulo 2 (dashboard de KPIs, aplicación externa).
# Si se deja vacío, la tarjeta muestra un estado explicativo en vez de un enlace roto.
VITE_KPIS_URL=

# Supabase — core transaccional. Aún no se usa: no hay integración real.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
